# Copy this file to .env and adjust as needed.

# Server
PORT=4000
NODE_ENV=development

# Database — leave UNSET locally to use a file DB (server/data/arena.db).
# In production, point at a Turso (libSQL) database:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Frontend origin (for CORS + cookie). In dev this is the Vite server.
CLIENT_ORIGIN=http://localhost:5173

# JWT secrets — CHANGE THESE in production to long random strings.
JWT_SECRET=dev-only-change-me-super-secret-participant-key
JWT_ADMIN_SECRET=dev-only-change-me-super-secret-admin-key
# Token lifetime
JWT_EXPIRES_IN=7d

# Allowed signup email domain for participants
ALLOWED_EMAIL_DOMAIN=smail.iitm.ac.in

# Starting virtual capital (in rupees)
STARTING_CAPITAL=1000000

# Seed admin (created by `npm run seed`). Change before going live.
SEED_ADMIN_EMAIL=admin@financeclub.iitm.ac.in
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Competition Admin
